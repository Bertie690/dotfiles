#! /usr/bin/env bash

# skip if non login shell
if [[ $- != *i* ]]; then return 0 2>/dev/null; fi

# Prompt and shell integration setup

eval "$(oh-my-posh init bash --config "$POSH_CONFIG")"

command -v gh >/dev/null && eval "$(gh completion -s bash)" || true

[[ "$TERM_PROGRAM" == "vscode" ]] && . "$(code --locate-shell-integration-path bash)"
