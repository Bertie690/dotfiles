{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "upgrade": {
    "source": "cdn",
    "interval": "24h",
    "auto": true,
    "notice": true
  },
  "blocks": [
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "time",
          "style": "plain",
          "min_width": 50,
          "options": {
            "time_format": "15:04:05"
          },
          "template": " {{ .CurrentDate | date .Format }} ",
          "foreground": "#1393dd",
          "background": "#193549"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "plain",
          "options": {
            "macos": "",
            "windows": ""
          },
          "cache": {
            "duration": "5m",
            "strategy": "session"
          },
          "template": " {{ if eq .Env.TERM_PROGRAM \"vscode\" }}{{else}}{{ .Icon }}{{ end }}{{ if .WSL }} (WSL){{ end }} ",
          "foreground": "#d2f2d7",
          "background": "#546e7a"
        },
        {
          "type": "battery",
          "style": "powerline",
          "templates_logic": "join",
          "foreground": "#193549",
          "powerline_symbol": "<#14b0c5,background></>",
          "background": "#18a81d",
          "background_templates": [
            "{{if le .Percentage 10 }}#ff2819{{ else if le .Percentage 25 }}#fd8c30{{ else if le .Percentage 50 }}#e6e604{{ else if le .Percentage 75 }}#91cb0a{{end}}"
          ],
          "templates": [
            "{{ if le .Percentage 10 }} {{else if le .Percentage 25 }} {{ else if le .Percentage 50 }} {{ else if le .Percentage 75 }} {{ else }} {{end}} ",
            "{{ if eq \"Charging\" .State.String }}󱐋 {{end}}",
            "{{ if not .Error }}{{ .Percentage }} {{ end }}"
          ],
          "invert_powerline": true
        },
        {
          "options": {
            "folder_icon": "...",
            "folder_separator_icon": "/",
            "hide_root_location": true,
            "mapped_locations": {
              "/mnt/c": "C:/",
              "re:(.*/github/(?P<repo>[^/.]+)(?:\\.worktrees/[^/]+)?)": "/${repo}",
              "re:(.*/github)": "",
              "re:(.*/faire/(?P<repo>[^/.]+)(?:\\.worktrees/[^/]+)?)": "${repo}"
            },
            "mapped_locations_regex_expand": true,
            "max_depth": 4,
            "style": "agnoster_short"
          },
          "cache": {
            "duration": "10s",
            "strategy": "folder"
          },
          "template": " {{ .Path }} ",
          "foreground": "#193549",
          "powerline_symbol": "<parentBackground></>",
          "background": "#3e9dea",
          "type": "path",
          "style": "powerline"
        },
        {
          "options": {
            "status_formats": {
              "Modified": " ±%d"
            },
            "mapped_branches": {
              "matthew-taylor/*": ""
            }
          },
          "cache": {
            "duration": "20s",
            "strategy": "folder"
          },
          "template": " {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}",
          "foreground": "#193549",
          "powerline_symbol": "",
          "background": "#ffeb3b",
          "type": "git",
          "style": "powerline",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FFEB3B{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#FFCC80{{ end }}",
            "{{ if gt .Ahead 0 }}#B388FF{{ end }}",
            "{{ if gt .Behind 0 }}#B388FB{{ end }}"
          ]
        }
      ],
      "newline": true
    }
  ],
  "version": 4,
  "shell_integration": true,
  "final_space": true,
  "patch_pwsh_bleed": true
}